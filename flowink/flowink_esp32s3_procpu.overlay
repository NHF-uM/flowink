/ {
	fstab {
		compatible = "zephyr,fstab";

		ffs_sd: ffs_sd {
			compatible = "zephyr,fstab,fatfs";
			automount;
			disk-access;
			mount-point = "/SD:";
		};
	};
};

&spi3 {
	status = "okay";
	cs-gpios = <>;

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		power-delay-ms = <2000>;
		/* SPI时钟，SD卡SPI最高推荐24MHz，不要直接上24M先从8M调试 */
		spi-max-frequency = <8000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
		};
	};
};
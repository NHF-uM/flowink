mainmenu "FlowInk Configuration"

config WAKEUP_TIME_SEC
	int "Wakeup time in seconds"
	default 43200
	help
	  This option sets the time in seconds after which the device
	  will wake up from deep sleep. Defaults to 12 hours.

menu "WS2812 Sample Configuration"

config LED_STRIP_BRIGHTNESS
	int "LED brightness"
	default 3
	range 1 255
	help
	  Brightness level of each LED. Defaults to a low value to make
	  it easier to distinguish colors.

endmenu

menu "NET Configuration"

config WIFI_AP_SSID
	string "SSID of soft AP"
	help
	  SSID of the soft AP 
	  Fox example: "SOFT-AP"
	  
config WIFI_AP_PSK
	string "Pre-shared key for soft AP"
	help
	  WPA2 password used by the soft AP for client authentication.
	  For example: "PSK"

config WIFI_AP_IP_ADDRESS
	string "IP address of soft AP"
	help
	  IP address assigned to the soft AP interface.
	  For example: "192.168.4.1"

config WIFI_AP_NETMASK
	string "Netmask of soft AP"
	help
	  Subnet mask for the soft AP interface.
	  For example: "255.255.255.0"  

config HTTP_SERVER_SERVICE_PORT
	int "Port number for http service"
	default 80

endmenu

source "Kconfig.zephyr"
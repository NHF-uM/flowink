menu "WS2812 Configuration"

config LED_STRIP_BRIGHTNESS
	int "LED brightness"
	default 3
	range 1 255
	help
	  Brightness level of each LED. Defaults to a low value to make
	  it easier to distinguish colors.

endmenu

menu "WIFI AP Configuration"

config WIFI_AP_SSID
	string "SSID of soft AP"
	help
	  SSID of the soft AP 
	  Fox example: "SOFT-AP"
	  
config WIFI_AP_PSK
	string "Pre-shared key for soft AP"
	help
	  WPA2 password used by the soft AP for client authentication.
	  For example: "PSK"

config WIFI_AP_IP_ADDRESS
	string "IP address of soft AP"
	help
	  IP address assigned to the soft AP interface.
	  For example: "192.168.4.1"

config WIFI_AP_NETMASK
	string "Netmask of soft AP"
	help
	  Subnet mask for the soft AP interface.
	  For example: "255.255.255.0"

config WIFI_SSID
	string "SSID of the target AP"
	help
	  SSID of the access point to connect to in station mode.
	  For example: "TARGET-AP"

config WIFI_PSK
	string "Pre-shared key for target AP"
	help
	  WPA2 password used to connect to the target AP.
	  For example: "PSK"	  

endmenu

menu "WIFI HTTP Configuration"

config NET_SAMPLE_HTTP_SERVICE
	bool "Enable http service"
	default y

config NET_SAMPLE_HTTP_SERVER_SERVICE_PORT
	int "Port number for http service"
	default 80
	depends on NET_SAMPLE_HTTP_SERVICE

endmenu

source "samples/net/common/Kconfig"
source "Kconfig.zephyr"
